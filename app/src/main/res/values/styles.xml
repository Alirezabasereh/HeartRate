<resources>
    <!-- Main screens: light gray background like Samsung Health -->
    <style name="Theme.HeartRate" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/coral</item>
        <item name="colorPrimaryVariant">@color/coral_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/coral</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Measuring screen: near-white background -->
    <style name="Theme.HeartRate.Measure">
        <item name="android:windowBackground">@color/bg_measure</item>
        <item name="android:statusBarColor">@color/bg_measure</item>
    </style>
</resources>
