<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.heartrate">

    <!-- Permission required to read body sensors such as heart rate -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Step counter: no runtime permission needed when targeting API < 29; declared for newer Android versions -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Re-schedules the hourly step snapshots after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Keeps the step counter running in the background (foreground service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- Declares heart-rate sensor usage; not required so the app can still be installed/tested anywhere -->
    <uses-feature
        android:name="android.hardware.sensor.heartrate"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.HeartRate">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HeartRateActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <service
            android:name=".StepTrackingService"
            android:exported="false" />

        <activity
            android:name=".SummaryActivity"
            android:exported="false" />

        <activity
            android:name=".StepsActivity"
            android:exported="false" />

        <receiver
            android:name=".DailyActivityWidget"
            android:exported="true"
            android:label="@string/widget_daily_activity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_activity_info" />
        </receiver>

        <receiver
            android:name=".StepsWidget"
            android:exported="true"
            android:label="@string/widget_steps">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info" />
        </receiver>

        <receiver
            android:name=".DailyActivityLargeWidget"
            android:exported="true"
            android:label="@string/widget_daily_activity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_activity_large_info" />
        </receiver>

        <receiver
            android:name=".ClockPlainWidget"
            android:exported="true"
            android:label="@string/widget_clock_plain">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_1_info" />
        </receiver>

        <receiver
            android:name=".ClockTicksWidget"
            android:exported="true"
            android:label="@string/widget_clock_ticks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_2_info" />
        </receiver>

        <receiver
            android:name=".ClockNumbersWidget"
            android:exported="true"
            android:label="@string/widget_clock_numbers">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_3_info" />
        </receiver>

        <receiver
            android:name=".ClockFlowerWidget"
            android:exported="true"
            android:label="@string/widget_clock_flower">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_4_info" />
        </receiver>

        <receiver
            android:name=".StepAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".RecordDetailActivity"
            android:exported="false" />

        <activity
            android:name=".MeasurementActivity"
            android:exported="false"
            android:theme="@style/Theme.HeartRate.Measure" />

    </application>

</manifest>
