<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.heartrate">

    <!-- Permission required to read body sensors such as heart rate -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Declares heart-rate sensor usage; not required so the app can still be installed/tested anywhere -->
    <uses-feature
        android:name="android.hardware.sensor.heartrate"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.HeartRate">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RecordDetailActivity"
            android:exported="false" />

        <activity
            android:name=".MeasurementActivity"
            android:exported="false"
            android:theme="@style/Theme.HeartRate.Measure" />

    </application>

</manifest>
