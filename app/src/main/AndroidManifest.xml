<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.heartrate">

    <!-- Permission required to read body sensors such as heart rate -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Step counter: no runtime permission needed when targeting API < 29; declared for newer Android versions -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Re-schedules the hourly step snapshots after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- Declares heart-rate sensor usage; not required so the app can still be installed/tested anywhere -->
    <uses-feature
        android:name="android.hardware.sensor.heartrate"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.HeartRate">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HeartRateActivity"
            android:exported="false" />

        <activity
            android:name=".StepsActivity"
            android:exported="false" />

        <receiver
            android:name=".StepAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".RecordDetailActivity"
            android:exported="false" />

        <activity
            android:name=".MeasurementActivity"
            android:exported="false"
            android:theme="@style/Theme.HeartRate.Measure" />

    </application>

</manifest>
